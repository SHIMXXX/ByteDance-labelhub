{
  "permissions": {
    "allow": [
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(git fetch:*)",
      "Bash(git checkout:*)",
      "Bash(git branch:*)",
      "Bash(git commit:*)",
      "Bash(git add:*)",
      "Bash(npm run:*)",
      "Bash(npm install:*)",
      "Bash(npx tsc:*)",
      "Bash(npx eslint:*)",
      "Bash(python:*)",
      "Bash(pip:*)",
      "Bash(uvicorn:*)",
      "Bash(mkdir:*)",
      "WebSearch",
      "WebFetch"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'echo \"[提示] 文件已修改，需要审查可以说 审查变更 或 用 code-reviewer/schema-reviewer 审查\"'"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": false,
    "ui-ux-pro-max@ui-ux-pro-max-skill": true,
    "ralph-wiggum@claude-code-plugins": true,
    "claude-hud@claude-hud": true
  },
  "skipWebFetchPreflight": true
}
